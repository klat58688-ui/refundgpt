# --- LLM (any OpenAI-compatible endpoint: OpenAI / Claude proxy / 51kik gateway) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-key-here
LLM_MODEL=gpt-4o
# Note: kimi-k3 via 51kik works too, but requires temperature=1.0 (already handled in code)
# and is a reasoning model — keep max_tokens headroom.

# --- PayPal Sandbox ---
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-secret

# --- App ---
DATABASE_URL=sqlite:///./refundgpt.db
CORS_ORIGINS=http://localhost:5173
# Refund amounts above this require explicit override_threshold=true in the decision call
AUTO_REFUND_THRESHOLD=100.00
# Optional: when set, all /api/refunds* endpoints require header X-API-Key
API_KEY=
